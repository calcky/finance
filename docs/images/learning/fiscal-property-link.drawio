<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="drawio" version="29.6.1"><diagram id="fiscal-property-link" name="房地产与地方财政：连接存在，但不是一比一"><mxGraphModel grid="1" gridSize="10" page="0" pageWidth="1200" pageHeight="820" background="#ffffff"><root>
<mxCell id="0"/>
<mxCell id="1" parent="0"/>
<mxCell id="canvas" value="" style="container=1;pointerEvents=0;html=0;fillColor=#ffffff;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="1200" height="820" as="geometry"/></mxCell>
<mxCell id="title" value="房地产与地方财政：连接存在，但不是一比一" style="text;fontSize=30;align=left;html=0;whiteSpace=nowrap;fontFamily=Microsoft YaHei;fontColor=#203047;" vertex="1" parent="canvas"><mxGeometry x="30" y="20" width="1140" height="50" as="geometry"/></mxCell>
<mxCell id="subtitle" value="销售、拿地与财政支出处在不同环节；不能用全国房屋销售额直接推算土地财政收入。" style="text;fontSize=21;align=left;html=0;whiteSpace=nowrap;fontFamily=Microsoft YaHei;fontColor=#203047;" vertex="1" parent="canvas"><mxGeometry x="30" y="85" width="1140" height="60" as="geometry"/></mxCell>
<mxCell id="sales" value="住房销售与预期变化&#xa;开发商回款、库存变化&#xa;各城市与项目差异很大" style="rounded=1;arcSize=8;fontSize=22;fillColor=#eaf3ff;strokeColor=#3b74b8;strokeWidth=1.5;html=0;whiteSpace=nowrap;fontFamily=Microsoft YaHei;fontColor=#203047;" vertex="1" parent="canvas"><mxGeometry x="30" y="200" width="320" height="130" as="geometry"/></mxCell>
<mxCell id="purchase" value="开发商拿地能力与意愿&#xa;受融资、库存和预期影响&#xa;销售回升未必马上拿地" style="rounded=1;arcSize=8;fontSize=22;fillColor=#eaf3ff;strokeColor=#3b74b8;strokeWidth=1.5;html=0;whiteSpace=nowrap;fontFamily=Microsoft YaHei;fontColor=#203047;" vertex="1" parent="canvas"><mxGeometry x="440" y="200" width="320" height="130" as="geometry"/></mxCell>
<mxCell id="land" value="土地出让收入&#xa;还受供地与缴款进度影响&#xa;进入地方政府性基金预算" style="rounded=1;arcSize=8;fontSize=22;fillColor=#eaf3ff;strokeColor=#3b74b8;strokeWidth=1.5;html=0;whiteSpace=nowrap;fontFamily=Microsoft YaHei;fontColor=#203047;" vertex="1" parent="canvas"><mxGeometry x="850" y="200" width="320" height="130" as="geometry"/></mxCell>
<mxCell id="public" value="税收及其他财政来源&#xa;房地产相关税收也会变化&#xa;地方还有转移支付等来源" style="rounded=1;arcSize=8;fontSize=22;fillColor=#e9f6ef;strokeColor=#2e8060;strokeWidth=1.5;html=0;whiteSpace=nowrap;fontFamily=Microsoft YaHei;fontColor=#203047;" vertex="1" parent="canvas"><mxGeometry x="30" y="470" width="320" height="130" as="geometry"/></mxCell>
<mxCell id="capacity" value="综合财力与支出安排&#xa;要考虑刚性支出和债务&#xa;不能只看土地收入一项" style="rounded=1;arcSize=8;fontSize=22;fillColor=#e9f6ef;strokeColor=#2e8060;strokeWidth=1.5;html=0;whiteSpace=nowrap;fontFamily=Microsoft YaHei;fontColor=#203047;" vertex="1" parent="canvas"><mxGeometry x="440" y="470" width="320" height="130" as="geometry"/></mxCell>
<mxCell id="landuse" value="土地相关支出空间&#xa;收入有对应成本和用途&#xa;可能影响相关项目安排" style="rounded=1;arcSize=8;fontSize=22;fillColor=#e9f6ef;strokeColor=#2e8060;strokeWidth=1.5;html=0;whiteSpace=nowrap;fontFamily=Microsoft YaHei;fontColor=#203047;" vertex="1" parent="canvas"><mxGeometry x="850" y="470" width="320" height="130" as="geometry"/></mxCell>
<mxCell id="e0" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=0;endArrow=block;endFill=1;strokeWidth=1.5;dashed=1;strokeColor=#415a77;exitX=1;exitY=.5;entryX=0;entryY=.5;" edge="1" parent="canvas" source="sales" target="purchase"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="e1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=0;endArrow=block;endFill=1;strokeWidth=1.5;dashed=1;strokeColor=#415a77;exitX=1;exitY=.5;entryX=0;entryY=.5;" edge="1" parent="canvas" source="purchase" target="land"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="e2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=0;endArrow=block;endFill=1;strokeWidth=1.5;dashed=1;strokeColor=#415a77;exitX=.5;exitY=1;entryX=.5;entryY=0;" edge="1" parent="canvas" source="land" target="landuse"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="e3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=0;endArrow=block;endFill=1;strokeWidth=1.5;dashed=1;strokeColor=#415a77;exitX=1;exitY=.5;entryX=0;entryY=.5;" edge="1" parent="canvas" source="public" target="capacity"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="note0" value="土地出让收入减少，可能约束相关支出；中央支持、债券安排、结转结余等也会影响结果。" style="text;fontSize=21;align=left;html=0;whiteSpace=nowrap;fontFamily=Microsoft YaHei;fontColor=#203047;" vertex="1" parent="canvas"><mxGeometry x="30" y="670" width="1140" height="70" as="geometry"/></mxCell>
<mxCell id="note1" value="土地出让收入 ≠ 地方全部财政收入；土地出让收入 − 土地相关支出也不是现成的净利润指标。" style="text;fontSize=21;align=left;html=0;whiteSpace=nowrap;fontFamily=Microsoft YaHei;fontColor=#203047;" vertex="1" parent="canvas"><mxGeometry x="30" y="745" width="1140" height="50" as="geometry"/></mxCell>
<mxCell id="e4" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=0;endArrow=block;endFill=1;strokeWidth=1.5;dashed=1;strokeColor=#415a77;exitX=0;exitY=.5;entryX=1;entryY=.5;" edge="1" parent="canvas" source="landuse" target="capacity"><mxGeometry relative="1" as="geometry"/></mxCell>
</root></mxGraphModel></diagram></mxfile>
