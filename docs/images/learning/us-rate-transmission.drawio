<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="drawio" version="29.6.1"><diagram id="us-rate-transmission" name="加息与降息：从政策到经济需要哪些条件"><mxGraphModel grid="1" gridSize="10" page="0" pageWidth="1200" pageHeight="820" background="#ffffff"><root>
<mxCell id="0"/>
<mxCell id="1" parent="0"/>
<mxCell id="canvas" value="" style="container=1;pointerEvents=0;fillColor=#ffffff;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="1200" height="820" as="geometry"/></mxCell>
<mxCell id="title" value="加息与降息：从政策到经济需要哪些条件" style="text;fontSize=30;align=left;html=0;whiteSpace=nowrap;fontFamily=Microsoft YaHei;fontColor=#203047;" vertex="1" parent="canvas"><mxGeometry x="30" y="20" width="1140" height="50" as="geometry"/></mxCell>
<mxCell id="subtitle" value="箭头是可能发生、带有时滞的传导，不是对下一次市场涨跌的保证。" style="text;fontSize=21;align=left;html=0;whiteSpace=nowrap;fontFamily=Microsoft YaHei;fontColor=#203047;" vertex="1" parent="canvas"><mxGeometry x="30" y="85" width="1140" height="60" as="geometry"/></mxCell>
<mxCell id="policy" value="政策行动与沟通&#xa;市场重估未来利率路径&#xa;预期可先于实际加减息变化" style="rounded=1;arcSize=8;fontSize=22;strokeWidth=1.5;fillColor=#eaf3ff;strokeColor=#3b74b8;html=0;whiteSpace=nowrap;fontFamily=Microsoft YaHei;fontColor=#203047;" vertex="1" parent="canvas"><mxGeometry x="30" y="190" width="320" height="140" as="geometry"/></mxCell>
<mxCell id="conditions" value="金融条件变化&#xa;市场利率、信用、汇率与估值&#xa;变化也受风险溢价影响" style="rounded=1;arcSize=8;fontSize=22;strokeWidth=1.5;fillColor=#eaf3ff;strokeColor=#3b74b8;html=0;whiteSpace=nowrap;fontFamily=Microsoft YaHei;fontColor=#203047;" vertex="1" parent="canvas"><mxGeometry x="440" y="190" width="320" height="140" as="geometry"/></mxCell>
<mxCell id="spending" value="借款与支出选择&#xa;企业投资、住房与耐用品&#xa;并非所有贷款立即重定价" style="rounded=1;arcSize=8;fontSize=22;strokeWidth=1.5;fillColor=#eaf3ff;strokeColor=#3b74b8;html=0;whiteSpace=nowrap;fontFamily=Microsoft YaHei;fontColor=#203047;" vertex="1" parent="canvas"><mxGeometry x="850" y="190" width="320" height="140" as="geometry"/></mxCell>
<mxCell id="demand" value="总需求与就业&#xa;取决于收入、债务与信心&#xa;不是每次加息都必然衰退" style="rounded=1;arcSize=8;fontSize=22;strokeWidth=1.5;fillColor=#e9f6ef;strokeColor=#2e8060;html=0;whiteSpace=nowrap;fontFamily=Microsoft YaHei;fontColor=#203047;" vertex="1" parent="canvas"><mxGeometry x="850" y="470" width="320" height="140" as="geometry"/></mxCell>
<mxCell id="prices" value="通胀与工资压力&#xa;需求变化逐步传导&#xa;也受供给冲击等因素影响" style="rounded=1;arcSize=8;fontSize=22;strokeWidth=1.5;fillColor=#e9f6ef;strokeColor=#2e8060;html=0;whiteSpace=nowrap;fontFamily=Microsoft YaHei;fontColor=#203047;" vertex="1" parent="canvas"><mxGeometry x="440" y="470" width="320" height="140" as="geometry"/></mxCell>
<mxCell id="review" value="新数据与政策评估&#xa;再次评估就业和物价&#xa;未来政策路径可能改变" style="rounded=1;arcSize=8;fontSize=22;strokeWidth=1.5;fillColor=#e9f6ef;strokeColor=#2e8060;html=0;whiteSpace=nowrap;fontFamily=Microsoft YaHei;fontColor=#203047;" vertex="1" parent="canvas"><mxGeometry x="30" y="470" width="320" height="140" as="geometry"/></mxCell>
<mxCell id="e0" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=0;endArrow=block;endFill=1;strokeWidth=1.5;dashed=1;strokeColor=#415a77;exitX=1;exitY=.5;entryX=0;entryY=.5;" edge="1" parent="canvas" source="policy" target="conditions"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="e1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=0;endArrow=block;endFill=1;strokeWidth=1.5;dashed=1;strokeColor=#415a77;exitX=1;exitY=.5;entryX=0;entryY=.5;" edge="1" parent="canvas" source="conditions" target="spending"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="e2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=0;endArrow=block;endFill=1;strokeWidth=1.5;dashed=1;strokeColor=#415a77;exitX=.5;exitY=1;entryX=.5;entryY=0;" edge="1" parent="canvas" source="spending" target="demand"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="e3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=0;endArrow=block;endFill=1;strokeWidth=1.5;dashed=1;strokeColor=#415a77;exitX=0;exitY=.5;entryX=1;entryY=.5;" edge="1" parent="canvas" source="demand" target="prices"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="e4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=0;endArrow=block;endFill=1;strokeWidth=1.5;dashed=1;strokeColor=#415a77;exitX=0;exitY=.5;entryX=1;entryY=.5;" edge="1" parent="canvas" source="prices" target="review"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="note0" value="短期资产价格反应可以很快，贷款重定价、投资和物价调整通常需要更长时间。" style="text;fontSize=20;align=left;html=0;whiteSpace=nowrap;fontFamily=Microsoft YaHei;fontColor=#203047;" vertex="1" parent="canvas"><mxGeometry x="30" y="715" width="1140" height="40" as="geometry"/></mxCell>
<mxCell id="note1" value="观察政策时同时看“已经做了什么”和“市场原本预期什么”，不能只看加减息方向。" style="text;fontSize=20;align=left;html=0;whiteSpace=nowrap;fontFamily=Microsoft YaHei;fontColor=#203047;" vertex="1" parent="canvas"><mxGeometry x="30" y="760" width="1140" height="40" as="geometry"/></mxCell>
</root></mxGraphModel></diagram></mxfile>
