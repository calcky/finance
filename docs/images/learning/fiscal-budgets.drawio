<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="drawio" version="29.6.1"><diagram id="fiscal-budgets" name="政府收支：先认清是哪本预算账"><mxGraphModel grid="1" gridSize="10" page="0" pageWidth="1200" pageHeight="820" background="#ffffff"><root>
<mxCell id="0"/>
<mxCell id="1" parent="0"/>
<mxCell id="canvas" value="" style="container=1;pointerEvents=0;html=0;fillColor=#ffffff;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="1200" height="820" as="geometry"/></mxCell>
<mxCell id="title" value="政府收支：先认清是哪本预算账" style="text;fontSize=30;align=left;html=0;whiteSpace=nowrap;fontFamily=Microsoft YaHei;fontColor=#203047;" vertex="1" parent="canvas"><mxGeometry x="30" y="20" width="1140" height="50" as="geometry"/></mxCell>
<mxCell id="subtitle" value="图中展示最常见的两本账；税收、土地出让收入和发债，不能混作一项收入。" style="text;fontSize=21;align=left;html=0;whiteSpace=nowrap;fontFamily=Microsoft YaHei;fontColor=#203047;" vertex="1" parent="canvas"><mxGeometry x="30" y="85" width="1140" height="60" as="geometry"/></mxCell>
<mxCell id="tax" value="税收与非税收入&#xa;例如增值税、所得税&#xa;以及依法取得的非税收入" style="rounded=1;arcSize=8;fontSize=22;fillColor=#eaf3ff;strokeColor=#3b74b8;strokeWidth=1.5;html=0;whiteSpace=nowrap;fontFamily=Microsoft YaHei;fontColor=#203047;" vertex="1" parent="canvas"><mxGeometry x="30" y="210" width="320" height="130" as="geometry"/></mxCell>
<mxCell id="general" value="一般公共预算&#xa;中央与地方分别编制&#xa;政府间转移支付要去重" style="rounded=1;arcSize=8;fontSize=22;fillColor=#eaf3ff;strokeColor=#3b74b8;strokeWidth=1.5;html=0;whiteSpace=nowrap;fontFamily=Microsoft YaHei;fontColor=#203047;" vertex="1" parent="canvas"><mxGeometry x="440" y="210" width="320" height="130" as="geometry"/></mxCell>
<mxCell id="services" value="公共服务等支出&#xa;教育、社保就业、卫生等&#xa;具体用途须经预算安排" style="rounded=1;arcSize=8;fontSize=22;fillColor=#eaf3ff;strokeColor=#3b74b8;strokeWidth=1.5;html=0;whiteSpace=nowrap;fontFamily=Microsoft YaHei;fontColor=#203047;" vertex="1" parent="canvas"><mxGeometry x="850" y="210" width="320" height="130" as="geometry"/></mxCell>
<mxCell id="land" value="政府性基金收入&#xa;土地出让收入是其中一项&#xa;不是卖地后的净利润" style="rounded=1;arcSize=8;fontSize=22;fillColor=#e9f6ef;strokeColor=#2e8060;strokeWidth=1.5;html=0;whiteSpace=nowrap;fontFamily=Microsoft YaHei;fontColor=#203047;" vertex="1" parent="canvas"><mxGeometry x="30" y="470" width="320" height="130" as="geometry"/></mxCell>
<mxCell id="funds" value="政府性基金预算&#xa;与一般公共预算分开&#xa;依法规定用途并安排支出" style="rounded=1;arcSize=8;fontSize=22;fillColor=#e9f6ef;strokeColor=#2e8060;strokeWidth=1.5;html=0;whiteSpace=nowrap;fontFamily=Microsoft YaHei;fontColor=#203047;" vertex="1" parent="canvas"><mxGeometry x="440" y="470" width="320" height="130" as="geometry"/></mxCell>
<mxCell id="projects" value="相应项目与相关支出&#xa;例如土地开发等&#xa;收入不等于可任意支配额" style="rounded=1;arcSize=8;fontSize=22;fillColor=#e9f6ef;strokeColor=#2e8060;strokeWidth=1.5;html=0;whiteSpace=nowrap;fontFamily=Microsoft YaHei;fontColor=#203047;" vertex="1" parent="canvas"><mxGeometry x="850" y="470" width="320" height="130" as="geometry"/></mxCell>
<mxCell id="e0" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=0;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#415a77;exitX=1;exitY=.5;entryX=0;entryY=.5;" edge="1" parent="canvas" source="tax" target="general"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="e1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=0;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#415a77;exitX=1;exitY=.5;entryX=0;entryY=.5;" edge="1" parent="canvas" source="general" target="services"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="e2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=0;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#415a77;exitX=1;exitY=.5;entryX=0;entryY=.5;" edge="1" parent="canvas" source="land" target="funds"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="e3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=0;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#415a77;exitX=1;exitY=.5;entryX=0;entryY=.5;" edge="1" parent="canvas" source="funds" target="projects"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="note0" value="另外两本预算：国有资本经营预算、社会保险基金预算。跨预算调入调出不能重复加总。" style="text;fontSize=21;align=left;html=0;whiteSpace=nowrap;fontFamily=Microsoft YaHei;fontColor=#203047;" vertex="1" parent="canvas"><mxGeometry x="30" y="670" width="1140" height="70" as="geometry"/></mxCell>
<mxCell id="note1" value="发债属于融资安排。地方一般债、专项债分别纳入相应预算管理，不是税收或土地收入。" style="text;fontSize=21;align=left;html=0;whiteSpace=nowrap;fontFamily=Microsoft YaHei;fontColor=#203047;" vertex="1" parent="canvas"><mxGeometry x="30" y="750" width="1140" height="40" as="geometry"/></mxCell>
</root></mxGraphModel></diagram></mxfile>
