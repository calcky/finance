<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="drawio" version="29.6.1"><diagram id="us-real-yield" name="名义收益率、实际收益率与盈亏平衡通胀"><mxGraphModel grid="1" gridSize="10" page="0" pageWidth="1200" pageHeight="820" background="#ffffff"><root>
<mxCell id="0"/>
<mxCell id="1" parent="0"/>
<mxCell id="canvas" value="" style="container=1;pointerEvents=0;fillColor=#ffffff;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="1200" height="820" as="geometry"/></mxCell>
<mxCell id="title" value="名义收益率、实际收益率与盈亏平衡通胀" style="text;fontSize=30;align=left;html=0;whiteSpace=nowrap;fontFamily=Microsoft YaHei;fontColor=#203047;" vertex="1" parent="canvas"><mxGeometry x="30" y="20" width="1140" height="50" as="geometry"/></mxCell>
<mxCell id="subtitle" value="教学假设：同一交易日、同一 10 年期限；数字用于说明计算，不是当前行情。" style="text;fontSize=21;align=left;html=0;whiteSpace=nowrap;fontFamily=Microsoft YaHei;fontColor=#203047;" vertex="1" parent="canvas"><mxGeometry x="30" y="85" width="1140" height="60" as="geometry"/></mxCell>
<mxCell id="nominal" value="名义国债收益率&#xa;4.0%&#xa;以名义金额报价的收益率" style="rounded=1;arcSize=8;fontSize=22;strokeWidth=1.5;fillColor=#eaf3ff;strokeColor=#3b74b8;html=0;whiteSpace=nowrap;fontFamily=Microsoft YaHei;fontColor=#203047;" vertex="1" parent="canvas"><mxGeometry x="30" y="230" width="300" height="150" as="geometry"/></mxCell>
<mxCell id="minus" value="−" style="text;fontSize=36;html=0;whiteSpace=nowrap;fontFamily=Microsoft YaHei;fontColor=#203047;" vertex="1" parent="canvas"><mxGeometry x="350" y="260" width="80" height="80" as="geometry"/></mxCell>
<mxCell id="real" value="TIPS 实际收益率&#xa;1.5%&#xa;通胀保值国债的实际报价" style="rounded=1;arcSize=8;fontSize=22;strokeWidth=1.5;fillColor=#e9f6ef;strokeColor=#2e8060;html=0;whiteSpace=nowrap;fontFamily=Microsoft YaHei;fontColor=#203047;" vertex="1" parent="canvas"><mxGeometry x="450" y="230" width="300" height="150" as="geometry"/></mxCell>
<mxCell id="equals" value="=" style="text;fontSize=36;html=0;whiteSpace=nowrap;fontFamily=Microsoft YaHei;fontColor=#203047;" vertex="1" parent="canvas"><mxGeometry x="770" y="260" width="80" height="80" as="geometry"/></mxCell>
<mxCell id="breakeven" value="盈亏平衡通胀&#xa;2.5 个百分点&#xa;4.0% − 1.5%" style="rounded=1;arcSize=8;fontSize=22;strokeWidth=1.5;fillColor=#fff1df;strokeColor=#ba7b32;html=0;whiteSpace=nowrap;fontFamily=Microsoft YaHei;fontColor=#203047;" vertex="1" parent="canvas"><mxGeometry x="870" y="230" width="300" height="150" as="geometry"/></mxCell>
<mxCell id="realnote" value="TIPS 实际收益率不是“名义收益率减上月 CPI”&#xa;它来自通胀保值国债的市场定价&#xa;也不是投资者最终收益的无条件保证" style="rounded=1;arcSize=8;fontSize=22;strokeWidth=1.5;fillColor=#e9f6ef;strokeColor=#2e8060;html=0;whiteSpace=nowrap;fontFamily=Microsoft YaHei;fontColor=#203047;" vertex="1" parent="canvas"><mxGeometry x="30" y="480" width="550" height="140" as="geometry"/></mxCell>
<mxCell id="benote" value="盈亏平衡通胀不是纯粹的通胀预测&#xa;其中还包含通胀风险溢价、流动性等影响&#xa;差值变化不能全部解释为通胀预期变化" style="rounded=1;arcSize=8;fontSize=22;strokeWidth=1.5;fillColor=#fff1df;strokeColor=#ba7b32;html=0;whiteSpace=nowrap;fontFamily=Microsoft YaHei;fontColor=#203047;" vertex="1" parent="canvas"><mxGeometry x="620" y="480" width="550" height="140" as="geometry"/></mxCell>
<mxCell id="note0" value="两条原始序列都存在观测时才计算差值；缺失日不补零、不用前一日价格代替。" style="text;fontSize=20;align=left;html=0;whiteSpace=nowrap;fontFamily=Microsoft YaHei;fontColor=#203047;" vertex="1" parent="canvas"><mxGeometry x="30" y="715" width="1140" height="40" as="geometry"/></mxCell>
<mxCell id="note1" value="对照名义与实际收益率，可以区分部分驱动；不同期限、口径或日期不能随意相减。" style="text;fontSize=20;align=left;html=0;whiteSpace=nowrap;fontFamily=Microsoft YaHei;fontColor=#203047;" vertex="1" parent="canvas"><mxGeometry x="30" y="760" width="1140" height="40" as="geometry"/></mxCell>
</root></mxGraphModel></diagram></mxfile>
