<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="drawio" version="29.6.1"><diagram id="fiscal-bond-transmission" name="发债到需求：中间还隔着预算与实际支出"><mxGraphModel grid="1" gridSize="10" page="0" pageWidth="1200" pageHeight="820" background="#ffffff"><root>
<mxCell id="0"/>
<mxCell id="1" parent="0"/>
<mxCell id="canvas" value="" style="container=1;pointerEvents=0;html=0;fillColor=#ffffff;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="1200" height="820" as="geometry"/></mxCell>
<mxCell id="title" value="发债到需求：中间还隔着预算与实际支出" style="text;fontSize=30;align=left;html=0;whiteSpace=nowrap;fontFamily=Microsoft YaHei;fontColor=#203047;" vertex="1" parent="canvas"><mxGeometry x="30" y="20" width="1140" height="50" as="geometry"/></mxCell>
<mxCell id="subtitle" value="上排是新增资金用于项目的示意；下排是再融资用途。两者不能混作新增刺激。" style="text;fontSize=21;align=left;html=0;whiteSpace=nowrap;fontFamily=Microsoft YaHei;fontColor=#203047;" vertex="1" parent="canvas"><mxGeometry x="30" y="85" width="1140" height="60" as="geometry"/></mxCell>
<mxCell id="bond" value="债券发行与缴款&#xa;投资者取得政府债权&#xa;政府形成偿还本息的义务" style="rounded=1;arcSize=8;fontSize=22;fillColor=#eaf3ff;strokeColor=#3b74b8;strokeWidth=1.5;html=0;whiteSpace=nowrap;fontFamily=Microsoft YaHei;fontColor=#203047;" vertex="1" parent="canvas"><mxGeometry x="30" y="200" width="320" height="130" as="geometry"/></mxCell>
<mxCell id="budget" value="预算与资金安排&#xa;依法确定用途和额度&#xa;发行完成不等于已经花出" style="rounded=1;arcSize=8;fontSize=22;fillColor=#eaf3ff;strokeColor=#3b74b8;strokeWidth=1.5;html=0;whiteSpace=nowrap;fontFamily=Microsoft YaHei;fontColor=#203047;" vertex="1" parent="canvas"><mxGeometry x="440" y="200" width="320" height="130" as="geometry"/></mxCell>
<mxCell id="spend" value="实际支付与项目执行&#xa;形成采购、工程款等&#xa;还取决于项目和执行进度" style="rounded=1;arcSize=8;fontSize=22;fillColor=#eaf3ff;strokeColor=#3b74b8;strokeWidth=1.5;html=0;whiteSpace=nowrap;fontFamily=Microsoft YaHei;fontColor=#203047;" vertex="1" parent="canvas"><mxGeometry x="850" y="200" width="320" height="130" as="geometry"/></mxCell>
<mxCell id="refinance" value="再融资债券&#xa;按批准用途偿还存量债务&#xa;不直接等于新增项目投资" style="rounded=1;arcSize=8;fontSize=22;fillColor=#e9f6ef;strokeColor=#2e8060;strokeWidth=1.5;html=0;whiteSpace=nowrap;fontFamily=Microsoft YaHei;fontColor=#203047;" vertex="1" parent="canvas"><mxGeometry x="30" y="470" width="320" height="130" as="geometry"/></mxCell>
<mxCell id="repay" value="偿还旧债／债务置换&#xa;可能调整期限和利息负担&#xa;要看具体工具与债务范围" style="rounded=1;arcSize=8;fontSize=22;fillColor=#e9f6ef;strokeColor=#2e8060;strokeWidth=1.5;html=0;whiteSpace=nowrap;fontFamily=Microsoft YaHei;fontColor=#203047;" vertex="1" parent="canvas"><mxGeometry x="440" y="470" width="320" height="130" as="geometry"/></mxCell>
<mxCell id="demand" value="企业订单与居民收入&#xa;可能支持就业和需求&#xa;效果受闲置产能等约束" style="rounded=1;arcSize=8;fontSize=22;fillColor=#e9f6ef;strokeColor=#2e8060;strokeWidth=1.5;html=0;whiteSpace=nowrap;fontFamily=Microsoft YaHei;fontColor=#203047;" vertex="1" parent="canvas"><mxGeometry x="850" y="470" width="320" height="130" as="geometry"/></mxCell>
<mxCell id="e0" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=0;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#415a77;exitX=1;exitY=.5;entryX=0;entryY=.5;" edge="1" parent="canvas" source="bond" target="budget"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="e1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=0;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#415a77;exitX=1;exitY=.5;entryX=0;entryY=.5;" edge="1" parent="canvas" source="budget" target="spend"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="e2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=0;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#415a77;exitX=1;exitY=.5;entryX=0;entryY=.5;" edge="1" parent="canvas" source="refinance" target="repay"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="e3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=0;endArrow=block;endFill=1;strokeWidth=1.5;dashed=1;strokeColor=#415a77;exitX=.5;exitY=1;entryX=.5;entryY=0;" edge="1" parent="canvas" source="spend" target="demand"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="note0" value="箭头描述资金用途或条件性传导；偿债减压可能间接改善支出能力，不画成必然新增需求。" style="text;fontSize=21;align=left;html=0;whiteSpace=nowrap;fontFamily=Microsoft YaHei;fontColor=#203047;" vertex="1" parent="canvas"><mxGeometry x="30" y="670" width="1140" height="70" as="geometry"/></mxCell>
<mxCell id="note1" value="发行总额 ≠ 新增债务 ≠ 当年赤字。专项债 ≠ 新增债；再融资债也可能按规定用于化债。" style="text;fontSize=21;align=left;html=0;whiteSpace=nowrap;fontFamily=Microsoft YaHei;fontColor=#203047;" vertex="1" parent="canvas"><mxGeometry x="30" y="745" width="1140" height="50" as="geometry"/></mxCell>
</root></mxGraphModel></diagram></mxfile>
