<mxCell id="3" value="按顺序排除误读；资料不足时明确留白，不填造市场预期。" style="rounded=1;arcSize=8;whiteSpace=nowrap;html=0;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#203047;fillColor=#ffffff;strokeColor=#d2d9e3;strokeWidth=1.5;spacing=12;shape=text;fillColor=none;strokeColor=none;fontSize=20;align=left;spacing=0;" vertex="1" parent="canvas"><mxGeometry x="30" y="75" width="940" height="50" as="geometry"/></mxCell>
<mxCell id="4" value="1. 找原始来源&#xa;谁发布？哪份报告？" style="rounded=1;arcSize=8;whiteSpace=nowrap;html=0;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#203047;fillColor=#eaf3ff;strokeColor=#3b74b8;strokeWidth=1.5;spacing=12;fontSize=21;" vertex="1" parent="canvas"><mxGeometry x="30" y="150" width="260" height="125" as="geometry"/></mxCell>
