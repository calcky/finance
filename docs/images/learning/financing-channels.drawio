<mxfile host="drawio" version="29.6.1"><diagram id="financing-channels" name="融资从哪些渠道进入实体经济"><mxGraphModel grid="1" gridSize="10" page="0" pageWidth="1100" pageHeight="820" background="#ffffff"><root>
<mxCell id="0"/><mxCell id="1" parent="0"/>
<mxCell id="canvas" value="" style="container=1;pointerEvents=0;html=0;fillColor=#ffffff;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="1100" height="820" as="geometry"/></mxCell>
<mxCell id="title" value="融资从哪些渠道进入实体经济" style="text;html=0;whiteSpace=nowrap;fontFamily=Microsoft YaHei;fontSize=30;fontColor=#203047;align=left;" vertex="1" parent="canvas"><mxGeometry x="30" y="20" width="1040" height="50" as="geometry"/></mxCell>
<mxCell id="subtitle" value="按渠道拆社融，再按借款人和期限看贷款；两个统计角度不能相加。" style="text;html=0;whiteSpace=nowrap;fontFamily=Microsoft YaHei;fontSize=21;fontColor=#415a77;align=left;" vertex="1" parent="canvas"><mxGeometry x="30" y="80" width="1040" height="40" as="geometry"/></mxCell>
<mxCell id="header1" value="融资渠道" style="text;html=0;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#415a77;" vertex="1" parent="canvas"><mxGeometry x="50" y="140" width="400" height="40" as="geometry"/></mxCell>
<mxCell id="header2" value="典型融资对象" style="text;html=0;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#415a77;" vertex="1" parent="canvas"><mxGeometry x="710" y="140" width="340" height="40" as="geometry"/></mxCell>
<mxCell id="loans" value="人民币 / 外币贷款&#xa;社融只计对实体经济发放的部分" style="rounded=1;arcSize=8;html=0;whiteSpace=nowrap;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#203047;fillColor=#eaf3ff;strokeColor=#3b74b8;strokeWidth=1.5;" vertex="1" parent="canvas"><mxGeometry x="50" y="200" width="400" height="90" as="geometry"/></mxCell>
<mxCell id="borrowers" value="住户、非金融企业等&#xa;再区分短期 / 中长期" style="rounded=1;arcSize=8;html=0;whiteSpace=nowrap;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#203047;fillColor=#eaf3ff;strokeColor=#3b74b8;strokeWidth=1.5;" vertex="1" parent="canvas"><mxGeometry x="710" y="200" width="340" height="90" as="geometry"/></mxCell>
<mxCell id="entrusted" value="委托贷款 / 信托贷款&#xa;未贴现银行承兑汇票" style="rounded=1;arcSize=8;html=0;whiteSpace=nowrap;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#203047;fillColor=#f2edfa;strokeColor=#8064a2;strokeWidth=1.5;" vertex="1" parent="canvas"><mxGeometry x="50" y="330" width="400" height="90" as="geometry"/></mxCell>
<mxCell id="real-economy" value="实体经济融资&#xa;票据贴现后转入贷款统计" style="rounded=1;arcSize=8;html=0;whiteSpace=nowrap;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#203047;fillColor=#f2edfa;strokeColor=#8064a2;strokeWidth=1.5;" vertex="1" parent="canvas"><mxGeometry x="710" y="330" width="340" height="90" as="geometry"/></mxCell>
<mxCell id="market" value="企业债券 / 境内股票融资&#xa;债权融资与股权融资分别理解" style="rounded=1;arcSize=8;html=0;whiteSpace=nowrap;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#203047;fillColor=#e9f6ef;strokeColor=#2e8060;strokeWidth=1.5;" vertex="1" parent="canvas"><mxGeometry x="50" y="460" width="400" height="90" as="geometry"/></mxCell>
<mxCell id="companies" value="非金融企业&#xa;股票融资额不是股票市值" style="rounded=1;arcSize=8;html=0;whiteSpace=nowrap;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#203047;fillColor=#e9f6ef;strokeColor=#2e8060;strokeWidth=1.5;" vertex="1" parent="canvas"><mxGeometry x="710" y="460" width="340" height="90" as="geometry"/></mxCell>
<mxCell id="bonds" value="政府债券&#xa;国债、地方一般债与专项债" style="rounded=1;arcSize=8;html=0;whiteSpace=nowrap;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#203047;fillColor=#fff3e4;strokeColor=#b87926;strokeWidth=1.5;" vertex="1" parent="canvas"><mxGeometry x="50" y="590" width="400" height="90" as="geometry"/></mxCell>
<mxCell id="government" value="政府&#xa;不等于企业和居民贷款增加" style="rounded=1;arcSize=8;html=0;whiteSpace=nowrap;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#203047;fillColor=#fff3e4;strokeColor=#b87926;strokeWidth=1.5;" vertex="1" parent="canvas"><mxGeometry x="710" y="590" width="340" height="90" as="geometry"/></mxCell>
<mxCell id="e1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=0;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#415a77;exitX=1;exitY=.5;entryX=0;entryY=.5;" edge="1" parent="canvas" source="loans" target="borrowers"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="e2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=0;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#415a77;exitX=1;exitY=.5;entryX=0;entryY=.5;" edge="1" parent="canvas" source="entrusted" target="real-economy"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="e3" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=0;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#415a77;exitX=1;exitY=.5;entryX=0;entryY=.5;" edge="1" parent="canvas" source="market" target="companies"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="e4" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=0;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#415a77;exitX=1;exitY=.5;entryX=0;entryY=.5;" edge="1" parent="canvas" source="bonds" target="government"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="note" value="社融还有 ABS、贷款核销等统计项目：并非每项都是当月新借款。&#xa;图示不按金额比例绘制；单月增量、累计增量与月末余额分别阅读。" style="text;html=0;whiteSpace=nowrap;fontFamily=Microsoft YaHei;fontSize=21;fontColor=#415a77;align=left;" vertex="1" parent="canvas"><mxGeometry x="30" y="720" width="1040" height="70" as="geometry"/></mxCell>
</root></mxGraphModel></diagram></mxfile>
