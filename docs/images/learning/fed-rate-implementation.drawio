<mxfile host="drawio" version="29.6.1"><diagram id="fed-rate-implementation" name="目标区间如何影响市场实际利率"><mxGraphModel grid="1" gridSize="10" page="0" pageWidth="1200" pageHeight="820" background="#ffffff"><root>
<mxCell id="0"/>
<mxCell id="1" parent="0"/>
<mxCell id="canvas" value="" style="container=1;pointerEvents=0;fillColor=#ffffff;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="1200" height="820" as="geometry"/></mxCell>
<mxCell id="title" value="目标区间如何影响市场实际利率" style="text;fontSize=30;align=left;html=0;whiteSpace=nowrap;fontFamily=Microsoft YaHei;fontColor=#203047;" vertex="1" parent="canvas"><mxGeometry x="30" y="20" width="1140" height="50" as="geometry"/></mxCell>
<mxCell id="subtitle" value="充裕准备金框架下的简化关系：政策目标、管理利率与市场成交不是同一个数字。" style="text;fontSize=21;align=left;html=0;whiteSpace=nowrap;fontFamily=Microsoft YaHei;fontColor=#203047;" vertex="1" parent="canvas"><mxGeometry x="30" y="85" width="1140" height="60" as="geometry"/></mxCell>
<mxCell id="target" value="FOMC：设定联邦基金利率目标区间&#xa;通过实施安排影响隔夜货币市场，而非给每笔贷款统一定价" style="rounded=1;arcSize=8;fontSize=22;strokeWidth=1.5;fillColor=#eaf3ff;strokeColor=#3b74b8;html=0;whiteSpace=nowrap;fontFamily=Microsoft YaHei;fontColor=#203047;" vertex="1" parent="canvas"><mxGeometry x="30" y="170" width="1140" height="100" as="geometry"/></mxCell>
<mxCell id="iorb" value="准备金余额利率 IORB&#xa;美联储理事会设定&#xa;影响合资格银行持有准备金的回报" style="rounded=1;arcSize=8;fontSize=22;strokeWidth=1.5;fillColor=#e9f6ef;strokeColor=#2e8060;html=0;whiteSpace=nowrap;fontFamily=Microsoft YaHei;fontColor=#203047;" vertex="1" parent="canvas"><mxGeometry x="60" y="350" width="460" height="130" as="geometry"/></mxCell>
<mxCell id="onrrp" value="隔夜逆回购工具 ON RRP&#xa;提供另一种隔夜投资选择&#xa;面向符合条件的交易对手" style="rounded=1;arcSize=8;fontSize=22;strokeWidth=1.5;fillColor=#e9f6ef;strokeColor=#2e8060;html=0;whiteSpace=nowrap;fontFamily=Microsoft YaHei;fontColor=#203047;" vertex="1" parent="canvas"><mxGeometry x="680" y="350" width="460" height="130" as="geometry"/></mxCell>
<mxCell id="effr" value="有效联邦基金利率 EFFR&#xa;市场隔夜无担保交易形成的统计利率&#xa;目标与实际成交要分别观察" style="rounded=1;arcSize=8;fontSize=22;strokeWidth=1.5;fillColor=#eaf3ff;strokeColor=#3b74b8;html=0;whiteSpace=nowrap;fontFamily=Microsoft YaHei;fontColor=#203047;" vertex="1" parent="canvas"><mxGeometry x="300" y="580" width="600" height="110" as="geometry"/></mxCell>
<mxCell id="e0" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=0;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#415a77;exitX=.228;exitY=1;entryX=.5;entryY=0;" edge="1" parent="canvas" source="target" target="iorb"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="e1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=0;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#415a77;exitX=.772;exitY=1;entryX=.5;entryY=0;" edge="1" parent="canvas" source="target" target="onrrp"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="e2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=0;endArrow=block;endFill=1;strokeWidth=1.5;dashed=1;strokeColor=#415a77;exitX=.5;exitY=1;entryX=.2;entryY=0;" edge="1" parent="canvas" source="iorb" target="effr"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="290" y="530"/><mxPoint x="420" y="530"/></Array></mxGeometry></mxCell>
<mxCell id="e3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=0;endArrow=block;endFill=1;strokeWidth=1.5;dashed=1;strokeColor=#415a77;exitX=.5;exitY=1;entryX=.8;entryY=0;" edge="1" parent="canvas" source="onrrp" target="effr"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="910" y="530"/><mxPoint x="780" y="530"/></Array></mxGeometry></mxCell>
<mxCell id="note0" value="管理利率改变替代收益机会；资格、资产负债表成本等摩擦会影响实际成交。" style="text;fontSize=20;align=left;html=0;whiteSpace=nowrap;fontFamily=Microsoft YaHei;fontColor=#203047;" vertex="1" parent="canvas"><mxGeometry x="30" y="715" width="1140" height="40" as="geometry"/></mxCell>
<mxCell id="note1" value="IORB 与 ON RRP 不是机械的利率上下界。本图省略其他操作，不能套用于全部历史时期。" style="text;fontSize=20;align=left;html=0;whiteSpace=nowrap;fontFamily=Microsoft YaHei;fontColor=#203047;" vertex="1" parent="canvas"><mxGeometry x="30" y="760" width="1140" height="40" as="geometry"/></mxCell>
</root></mxGraphModel></diagram></mxfile>
