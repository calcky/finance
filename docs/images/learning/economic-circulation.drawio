<mxCell id="2" value="收入与消费怎样连接家庭和企业" style="rounded=1;arcSize=8;whiteSpace=nowrap;html=0;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#203047;fillColor=#ffffff;strokeColor=#d2d9e3;strokeWidth=1.5;spacing=12;shape=text;fillColor=none;strokeColor=none;fontSize=30;align=left;spacing=0;" vertex="1" parent="canvas"><mxGeometry x="30" y="15" width="940" height="50" as="geometry"/></mxCell>
<mxCell id="3" value="只画家庭与企业之间的部分货币流；政府、金融和海外关系在正文补充。" style="rounded=1;arcSize=8;whiteSpace=nowrap;html=0;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#203047;fillColor=#ffffff;strokeColor=#d2d9e3;strokeWidth=1.5;spacing=12;shape=text;fillColor=none;strokeColor=none;fontSize=20;align=left;spacing=0;" vertex="1" parent="canvas"><mxGeometry x="30" y="75" width="940" height="50" as="geometry"/></mxCell>
<mxCell id="4" value="家庭&#xa;&#xa;提供劳动等资源&#xa;取得收入、安排消费" style="rounded=1;arcSize=8;whiteSpace=nowrap;html=0;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#203047;fillColor=#e9f6ef;strokeColor=#2e8060;strokeWidth=1.5;spacing=12;" vertex="1" parent="canvas"><mxGeometry x="30" y="180" width="300" height="180" as="geometry"/></mxCell>
<mxCell id="5" value="企业&#xa;&#xa;组织生产与销售&#xa;支付工资等成本" style="rounded=1;arcSize=8;whiteSpace=nowrap;html=0;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#203047;fillColor=#eaf3ff;strokeColor=#3b74b8;strokeWidth=1.5;spacing=12;" vertex="1" parent="canvas"><mxGeometry x="670" y="180" width="300" height="180" as="geometry"/></mxCell>
<mxCell id="6" value="工资等收入" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=0;whiteSpace=nowrap;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#415a77;fontSize=20;fontFamily=Microsoft YaHei;fontColor=#203047;labelBackgroundColor=#ffffff;exitX=0;exitY=0.3;entryX=1;entryY=0.3;" edge="1" parent="canvas" source="5" target="4"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="7" value="消费支出" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=0;whiteSpace=nowrap;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#415a77;fontSize=20;fontFamily=Microsoft YaHei;fontColor=#203047;labelBackgroundColor=#ffffff;exitX=1;exitY=0.7;entryX=0;entryY=0.7;" edge="1" parent="canvas" source="4" target="5"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="8" value="流量：一段时间发生多少&#xa;月收入、月支出、月结余" style="rounded=1;arcSize=8;whiteSpace=nowrap;html=0;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#203047;fillColor=#e9f6ef;strokeColor=#2e8060;strokeWidth=1.5;spacing=12;" vertex="1" parent="canvas"><mxGeometry x="30" y="440" width="440" height="110" as="geometry"/></mxCell>
<mxCell id="9" value="存量：某个时点还剩多少&#xa;资产 − 负债 = 净资产" style="rounded=1;arcSize=8;whiteSpace=nowrap;html=0;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#203047;fillColor=#eaf3ff;strokeColor=#3b74b8;strokeWidth=1.5;spacing=12;" vertex="1" parent="canvas"><mxGeometry x="530" y="440" width="440" height="110" as="geometry"/></mxCell>
<mxCell id="10" value="借款可以增加现金流入，但同时增加负债，不等于增加收入或净财富。" style="rounded=1;arcSize=8;whiteSpace=nowrap;html=0;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#203047;fillColor=#ffffff;strokeColor=#d2d9e3;strokeWidth=1.5;spacing=12;shape=text;fillColor=none;strokeColor=none;fontSize=22;align=left;spacing=0;" vertex="1" parent="canvas"><mxGeometry x="30" y="590" width="940" height="40" as="geometry"/></mxCell>
