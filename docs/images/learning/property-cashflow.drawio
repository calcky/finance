<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="drawio" version="29.6.1"><diagram id="property-cashflow" name="房地产的工程进度与资金流"><mxGraphModel grid="1" gridSize="10" page="0" pageWidth="1200" pageHeight="810" background="#ffffff"><root>
<mxCell id="0"/><mxCell id="1" parent="0"/>
<mxCell id="canvas" value="" style="container=1;pointerEvents=0;html=0;fillColor=#ffffff;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="1200" height="810" as="geometry"/></mxCell>
<mxCell id="title" value="房地产：工程进度与资金流，是两条不同的线" style="text;html=0;whiteSpace=nowrap;fontFamily=Microsoft YaHei;fontSize=30;fontColor=#203047;align=left;" vertex="1" parent="canvas"><mxGeometry x="30" y="20" width="1140" height="50" as="geometry"/></mxCell>
<mxCell id="subtitle" value="销售签约、收到购房款、房屋竣工和交付，往往发生在不同时间。" style="text;html=0;whiteSpace=nowrap;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#415a77;align=left;" vertex="1" parent="canvas"><mxGeometry x="30" y="90" width="1140" height="40" as="geometry"/></mxCell>
<mxCell id="physical" value="工程进度：绿色" style="text;html=0;whiteSpace=nowrap;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#2e8060;align=left;" vertex="1" parent="canvas"><mxGeometry x="40" y="160" width="380" height="40" as="geometry"/></mxCell>
<mxCell id="starts" value="新开工&#xa;本年新开始施工的房屋&#xa;统计建筑面积，不是套数" style="rounded=1;arcSize=8;html=0;whiteSpace=nowrap;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#203047;fillColor=#e9f6ef;strokeColor=#2e8060;strokeWidth=1.5;" vertex="1" parent="canvas"><mxGeometry x="40" y="220" width="300" height="120" as="geometry"/></mxCell>
<mxCell id="building" value="施工&#xa;本年施工过的房屋范围&#xa;包括上年结转等项目" style="rounded=1;arcSize=8;html=0;whiteSpace=nowrap;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#203047;fillColor=#e9f6ef;strokeColor=#2e8060;strokeWidth=1.5;" vertex="1" parent="canvas"><mxGeometry x="450" y="220" width="300" height="120" as="geometry"/></mxCell>
<mxCell id="complete" value="竣工 → 交付使用&#xa;达到竣工标准再交付&#xa;竣工统计不等于交房统计" style="rounded=1;arcSize=8;html=0;whiteSpace=nowrap;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#203047;fillColor=#e9f6ef;strokeColor=#2e8060;strokeWidth=1.5;" vertex="1" parent="canvas"><mxGeometry x="860" y="220" width="300" height="120" as="geometry"/></mxCell>
<mxCell id="cash-label" value="资金流：蓝色" style="text;html=0;whiteSpace=nowrap;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#3b74b8;align=left;" vertex="1" parent="canvas"><mxGeometry x="40" y="420" width="350" height="40" as="geometry"/></mxCell>
<mxCell id="sales" value="购房与销售签约&#xa;期房可以在竣工前销售&#xa;销售额不等于已收现金" style="rounded=1;arcSize=8;html=0;whiteSpace=nowrap;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#203047;fillColor=#eaf3ff;strokeColor=#3b74b8;strokeWidth=1.5;" vertex="1" parent="canvas"><mxGeometry x="40" y="490" width="300" height="130" as="geometry"/></mxCell>
<mxCell id="funds" value="开发企业到位资金&#xa;定金及预收款、按揭回款&#xa;国内贷款、自筹等" style="rounded=1;arcSize=8;html=0;whiteSpace=nowrap;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#203047;fillColor=#eaf3ff;strokeColor=#3b74b8;strokeWidth=1.5;" vertex="1" parent="canvas"><mxGeometry x="450" y="490" width="300" height="130" as="geometry"/></mxCell>
<mxCell id="spending" value="资金用途&#xa;工程、土地等开发支出&#xa;以及偿债等其他用途" style="rounded=1;arcSize=8;html=0;whiteSpace=nowrap;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#203047;fillColor=#eaf3ff;strokeColor=#3b74b8;strokeWidth=1.5;" vertex="1" parent="canvas"><mxGeometry x="860" y="490" width="300" height="130" as="geometry"/></mxCell>
<mxCell id="support-label" value="资金改善可能支持施工&#xa;受项目、监管与偿债安排约束" style="text;html=0;whiteSpace=nowrap;fontFamily=Microsoft YaHei;fontSize=20;fontColor=#415a77;align=left;" vertex="1" parent="canvas"><mxGeometry x="660" y="380" width="400" height="70" as="geometry"/></mxCell>
<mxCell id="e1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=0;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#2e8060;exitX=1;exitY=.5;entryX=0;entryY=.5;" edge="1" parent="canvas" source="starts" target="building"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="e2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=0;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#2e8060;exitX=1;exitY=.5;entryX=0;entryY=.5;" edge="1" parent="canvas" source="building" target="complete"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="e3" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=0;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#3b74b8;exitX=1;exitY=.5;entryX=0;entryY=.5;" edge="1" parent="canvas" source="sales" target="funds"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="e4" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=0;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#3b74b8;exitX=1;exitY=.5;entryX=0;entryY=.5;" edge="1" parent="canvas" source="funds" target="spending"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="e5" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=0;endArrow=block;endFill=1;strokeWidth=1.5;dashed=1;strokeColor=#415a77;exitX=.5;exitY=0;entryX=.5;entryY=1;" edge="1" parent="canvas" source="funds" target="building"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="note" value="这是机制示意，不是同一批项目的统计恒等式。不同阶段可以不同步。&#xa;开发投资、销售额、到位资金相互有关，但不能相加当作 GDP。" style="text;html=0;whiteSpace=nowrap;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#415a77;align=left;" vertex="1" parent="canvas"><mxGeometry x="30" y="680" width="1140" height="90" as="geometry"/></mxCell>
</root></mxGraphModel></diagram></mxfile>
