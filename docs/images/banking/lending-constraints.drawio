<mxfile host="drawio" version="29.6.1"><diagram id="lending-constraints" name="05  能创造存款，为什么不能无限放贷？"><mxGraphModel dx="1000" dy="660" grid="1" gridSize="10" page="0" pageWidth="1000" pageHeight="660" background="#ffffff"><root>
<mxCell id="0"/>
<mxCell id="1" parent="0"/>
<mxCell id="canvas" value="" style="container=1;pointerEvents=0;html=0;fillColor=#ffffff;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="1000" height="700" as="geometry"/></mxCell>
<mxCell id="2" value="05  能创造存款，为什么不能无限放贷？" style="rounded=1;arcSize=8;whiteSpace=nowrap;html=0;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#203047;fillColor=#ffffff;strokeColor=#d2d9e3;strokeWidth=1.5;spacing=12;shape=text;fillColor=none;strokeColor=none;fontSize=30;align=left;spacing=0;" vertex="1" parent="canvas"><mxGeometry x="20" y="10" width="960" height="50" as="geometry"/></mxCell>
<mxCell id="3" value="四类约束共同起作用；这不是按顺序通过就一定获批的流程。" style="rounded=1;arcSize=8;whiteSpace=nowrap;html=0;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#203047;fillColor=#ffffff;strokeColor=#d2d9e3;strokeWidth=1.5;spacing=12;shape=text;fillColor=none;strokeColor=none;fontSize=20;align=left;spacing=0;" vertex="1" parent="canvas"><mxGeometry x="20" y="65" width="960" height="45" as="geometry"/></mxCell>
<mxCell id="4" value="资本与监管&#xa;&#xa;风险资产会占用资本&#xa;还需满足杠杆、流动性等要求" style="rounded=1;arcSize=8;whiteSpace=nowrap;html=0;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#203047;fillColor=#eaf3ff;strokeColor=#3b74b8;strokeWidth=1.5;spacing=12;" vertex="1" parent="canvas"><mxGeometry x="30" y="150" width="440" height="160" as="geometry"/></mxCell>
<mxCell id="5" value="结算流动性与融资成本&#xa;&#xa;客户会转账、取现&#xa;银行要能结算，并负担融资成本" style="rounded=1;arcSize=8;whiteSpace=nowrap;html=0;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#203047;fillColor=#e9f6ef;strokeColor=#2e8060;strokeWidth=1.5;spacing=12;" vertex="1" parent="canvas"><mxGeometry x="530" y="150" width="440" height="160" as="geometry"/></mxCell>
<mxCell id="6" value="信用风险与盈利&#xa;&#xa;借款人能否还本付息？&#xa;利息能否覆盖成本和预期损失？" style="rounded=1;arcSize=8;whiteSpace=nowrap;html=0;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#203047;fillColor=#eaf3ff;strokeColor=#3b74b8;strokeWidth=1.5;spacing=12;" vertex="1" parent="canvas"><mxGeometry x="30" y="370" width="440" height="160" as="geometry"/></mxCell>
<mxCell id="7" value="借款需求与偿债能力&#xa;&#xa;企业有订单和投资机会吗？&#xa;居民有稳定收入与借款意愿吗？" style="rounded=1;arcSize=8;whiteSpace=nowrap;html=0;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#203047;fillColor=#e9f6ef;strokeColor=#2e8060;strokeWidth=1.5;spacing=12;" vertex="1" parent="canvas"><mxGeometry x="530" y="370" width="440" height="160" as="geometry"/></mxCell>
<mxCell id="8" value="降息 / 降准可能缓解部分约束，但不保证贷款和 M2 按固定倍数增长。" style="rounded=1;arcSize=8;whiteSpace=nowrap;html=0;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#203047;fillColor=#f5f7fa;strokeColor=#8995a5;strokeWidth=1.5;spacing=12;" vertex="1" parent="canvas"><mxGeometry x="30" y="590" width="940" height="80" as="geometry"/></mxCell>
</root></mxGraphModel></diagram></mxfile>
