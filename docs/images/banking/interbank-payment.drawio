<mxCell id="2" value="03  跨行付款：存款换主人，准备金换银行" style="rounded=1;arcSize=8;whiteSpace=nowrap;html=0;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#203047;fillColor=#ffffff;strokeColor=#d2d9e3;strokeWidth=1.5;spacing=12;shape=text;fillColor=none;strokeColor=none;fontSize=30;align=left;spacing=0;" vertex="1" parent="canvas"><mxGeometry x="20" y="10" width="960" height="50" as="geometry"/></mxCell>
<mxCell id="3" value="单位：万元。企业向商户付款 100；A 行结算余额充足；忽略费用。" style="rounded=1;arcSize=8;whiteSpace=nowrap;html=0;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#203047;fillColor=#ffffff;strokeColor=#d2d9e3;strokeWidth=1.5;spacing=12;shape=text;fillColor=none;strokeColor=none;fontSize=20;align=left;spacing=0;" vertex="1" parent="canvas"><mxGeometry x="20" y="65" width="960" height="45" as="geometry"/></mxCell>
<mxCell id="4" value="借款企业&#xa;在 A 行的存款 −100" style="rounded=1;arcSize=8;whiteSpace=nowrap;html=0;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#203047;fillColor=#e9f6ef;strokeColor=#2e8060;strokeWidth=1.5;spacing=12;" vertex="1" parent="canvas"><mxGeometry x="30" y="140" width="260" height="100" as="geometry"/></mxCell>
<mxCell id="5" value="收款商户&#xa;在 B 行的存款 +100" style="rounded=1;arcSize=8;whiteSpace=nowrap;html=0;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#203047;fillColor=#e9f6ef;strokeColor=#2e8060;strokeWidth=1.5;spacing=12;" vertex="1" parent="canvas"><mxGeometry x="710" y="140" width="260" height="100" as="geometry"/></mxCell>
<mxCell id="6" value="银行 A&#xa;&#xa;准备金资产 −100&#xa;客户存款负债 −100" style="rounded=1;arcSize=8;whiteSpace=nowrap;html=0;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#203047;fillColor=#eaf3ff;strokeColor=#3b74b8;strokeWidth=1.5;spacing=12;" vertex="1" parent="canvas"><mxGeometry x="30" y="350" width="260" height="150" as="geometry"/></mxCell>
<mxCell id="7" value="央行结算账簿&#xa;&#xa;A 行余额 −100&#xa;B 行余额 +100" style="rounded=1;arcSize=8;whiteSpace=nowrap;html=0;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#203047;fillColor=#f5f7fa;strokeColor=#8995a5;strokeWidth=1.5;spacing=12;" vertex="1" parent="canvas"><mxGeometry x="370" y="350" width="260" height="150" as="geometry"/></mxCell>
